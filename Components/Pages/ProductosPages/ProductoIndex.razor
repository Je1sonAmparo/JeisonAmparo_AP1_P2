@page "/Producto/Index"

@inject ProductosService productosService

<PageTitle>Consulta de Productos</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Consulta de Productos</h5>
        </div>

        @*labels*@
        <div class="card-body">
            <div class="row">

                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @*Inputs y botones*@
            <div class="row align-items-center">
                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="ProductoId">ProductoId</option>
                        <option value="Nombre">Nombre</option>
                        <option value="Precio">Precio</option>
                        <option value="Stock">Stock</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaProductos.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(p => p.ProductoId)" Title="ProductoId" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Nombre)" Title="Nombre" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Precio)" Title="Precio" Format="N2" Sortable="true" />
                    <PropertyColumn Property="@(p => p.Stock)" Title="Stock" Sortable="true" />
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaProductos.Count()</label>
        </div>
    </div>
</div>

@code {
    public List<Productos> ListaProductos { get; set; } = new List<Productos>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaProductos = await productosService.GetList(p => true);
    }

    private async Task Buscar()
    {
        if (ValorFiltro.Trim() != "")
        {
            if (Filtro == "ProductoId")
            {
                ListaProductos = await productosService.GetList(p => p.ProductoId.ToString().Contains(ValorFiltro));
            }

            if (Filtro == "Nombre")
            {
                ListaProductos = await productosService.GetList(p => p.Nombre.ToLower().Contains(ValorFiltro.ToLower()));
            }

            if (Filtro == "Precio")
            {
                ListaProductos = await productosService.GetList(p => p.Precio.ToString().Contains(ValorFiltro));
            }

            if (Filtro == "Stock")
            {
                ListaProductos = await productosService.GetList(p => p.Stock.ToString().Contains(ValorFiltro));
            }
        }
        else
        {
            ListaProductos = await productosService.GetList(p => true);
        }
    }
}
